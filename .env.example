# Supabase Configuration (Required)
# Get these from your Supabase project settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Telegram Bot (Optional - for Telegram bot feature)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NOTE: User API keys (OpenRouter, OpenAI, Anthropic, Tavily, Firecrawl, etc.)
# must be configured via the Settings → API Keys panel in the dashboard.
# Do not add them to this file.
